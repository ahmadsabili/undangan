# ---------- Supabase (Project Settings > API) ----------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...anon
# RAHASIA. Hanya untuk server (API RSVP & ucapan, skrip create-admin).
# Jangan pernah diberi awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service_role

# ---------- Situs ----------
# Domain final tanpa garis miring di akhir. Dipakai untuk tautan undangan & preview WhatsApp.
NEXT_PUBLIC_SITE_URL=https://undangan-anda.vercel.app

# Teks acak untuk meng-hash IP saat rate limiting (IP mentah tidak disimpan).
RATE_LIMIT_SALT=ganti-dengan-teks-acak-panjang

# ---------- Opsional, hanya development ----------
# Pratinjau desain tanpa Supabase: arahkan ke file snapshot JSON (lihat README).
# DESIGN_PREVIEW_FIXTURE=./supabase/fixture.json

# Opsional: bila diisi, /api/cron/daily hanya menerima panggilan cron Vercel.
CRON_SECRET=
